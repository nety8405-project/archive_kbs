# ========================
# 사내 아카이브 설정
# ========================
ARCHIVE_BASE_URL=http://your-archive-server.internal
ARCHIVE_USERNAME=your_id
ARCHIVE_PASSWORD=your_password

# 사내망 IP 대역 (접속 검증용)
INTERNAL_SUBNET=192.168.1.

# ========================
# OpenAI (Whisper + GPT)
# ========================
OPENAI_API_KEY=sk-...

# ========================
# YouTube API
# ========================
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_TOKEN_FILE=config/youtube_token.json

# ========================
# 파이프라인 설정
# ========================
# 다운로드 저장 경로
DOWNLOAD_DIR=data/downloads

# 쇼츠 저장 경로
SHORTS_DIR=data/shorts

# 처리 완료 영상 경로
PROCESSED_DIR=data/processed

# 흥미도 점수 기준 (이 점수 이상인 구간만 쇼츠로 만들기)
MIN_INTEREST_SCORE=7

# 쇼츠 최대 길이 (초)
SHORTS_MAX_DURATION=60

# 쇼츠 최소 길이 (초)
SHORTS_MIN_DURATION=15
